VITE_API_BASE_URL=http://localhost:3000/api/v1

# When "true", features without a live backend endpoint yet (AI scan
# classification) clearly label their output as sample/mock data in the UI.
VITE_USE_MOCK_AI=true

# To point this app at the Dockerized backend (infra/docker/docker-compose.yml)
# instead of a bare `npm run start:dev` one: that backend's container port
# 3000 is published to a random host port (not a fixed one, so it doesn't
# conflict with `docker compose up --scale backend=N` — see
# docs/phases/phase-12.md). Find it with:
#   docker compose port backend 3000
# then set VITE_API_BASE_URL above to http://localhost:<that port>/api/v1.
# infra/docker/.env's CORS_ORIGIN already includes this app's dev origin
# (http://localhost:5174, see vite.config.ts) so the backend accepts it.
