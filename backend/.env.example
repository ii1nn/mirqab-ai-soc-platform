NODE_ENV=development
PORT=3000

# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://mirqab:mirqab@localhost:5432/mirqab?schema=public"

# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace-with-a-64-char-random-string-for-access-tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string-for-refresh
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# Comma-separated list of allowed origins (e.g. SOC dashboard + employee app).
# Also used by the /realtime WebSocket gateway's CORS config.
CORS_ORIGIN=http://localhost:5173

# Optional — base URL of the SOC Dashboard SPA, used to build the
# password-reset link returned by POST /auth/forgot-password. Defaults to
# the first CORS_ORIGIN entry when unset.
APP_URL=http://localhost:5173

# Used only by `npm run prisma:seed` to bootstrap the first admin account
ADMIN_EMAIL=admin@mirqab.local
ADMIN_PASSWORD=ChangeMe123!

# Phase 8: Mirqab's default/production AI path is self-hosted/private —
# point this at an internal-only, OpenAI-compatible inference endpoint
# (e.g. an in-network llama.cpp/vLLM/Ollama service). Optional — the AI
# engine (backend/src/modules/ai) falls back to rule-based triage when this
# is unset, so the app runs fully without any AI backend at all. Never a
# client-suppliable value — this is server config only.
SELF_HOSTED_AI_URL=
SELF_HOSTED_AI_MODEL=
SELF_HOSTED_AI_TIMEOUT_MS=30000

# EXTERNAL/CLOUD AI — Anthropic Claude. Local development / model-quality
# comparison ONLY. Never set ALLOW_EXTERNAL_AI_DEV_ONLY=true in production —
# doing so sends incident/log data to a third-party cloud API. Setting
# ANTHROPIC_API_KEY alone does nothing; both must be set together.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ALLOW_EXTERNAL_AI_DEV_ONLY=false

# Shared secret the Wazuh/Suricata/Sysmon forwarders present via the
# X-Api-Key header on POST /monitoring/* (see backend/src/modules/monitoring).
# Generate with: openssl rand -hex 32
MONITORING_INGEST_API_KEY=replace-with-a-long-random-shared-secret-for-monitoring-agents

# Optional — unset means RealtimeGateway runs single-instance (see
# backend/src/redis/redis.service.ts). Set this to run more than one backend
# replica behind the same load balancer so WebSocket broadcasts reach every
# instance's connected clients, not just the one that received the event.
REDIS_URL=

# Optional — a real Wazuh Manager's REST API (default port 55000). Unset
# means WazuhLogtestClient degrades to unavailable and monitoring ingestion
# falls back to its own heuristic decoding (see
# backend/src/modules/monitoring/wazuh-logtest and
# docs/integrations/phase-3-wazuh-logtest-enrichment.md).
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=

# Optional — name of the custom Active Response <command> you registered on
# the Wazuh manager's ossec.conf that actually isolates a device (see
# infra/monitoring/wazuh/active-response/). Only set this AFTER you've
# written, installed, and registered that command for real — this variable
# existing is what lets EndpointControlService treat Wazuh Active Response as
# available; leaving it empty keeps isolation PENDING even with the three
# WAZUH_API_* vars above set.
#
# IMPORTANT: this is the SCRIPT/EXECUTABLE filename (<command><executable>
# in ossec.conf, e.g. "isolate-host.sh") — NOT the <command><name>, and NOT
# an ar.conf-style "name+timeout" identifier (both were tried and both
# produced a real HTTP 400 from the Wazuh Manager API: {"title": "Bad
# Request", "detail": "'!<value>' is not a 'active_response_command' -
# 'command'"}). Per Wazuh's own OpenAPI spec, the PUT /active-response
# body's "command" field is documented as: "If this value starts with '!',
# then it refers to a script name instead of a command name."
# WazuhActiveResponseProvider always sends "!" + this value, so it must be
# the real executable filename installed on the agent, not the name you
# gave the <command> block.
WAZUH_ISOLATION_AR_COMMAND=

# Optional — a real EDR/NAC/firewall endpoint-control provider capable of
# actually cutting a device's network access. Unset means EndpointControlService
# degrades to unavailable and ISOLATE_DEVICE actions stay PENDING until an
# analyst manually confirms the real-world result (see
# backend/src/modules/devices/endpoint-control/endpoint-control.service.ts).
# Contract MIRQAB calls against this base URL: POST {ENDPOINT_CONTROL_API_URL}/isolate
#   Headers: Authorization: Bearer {ENDPOINT_CONTROL_API_KEY}, Content-Type: application/json
#   Body:    { "hostname": "<device hostname>", "ipAddress": "<device ip>" }
#   Expected 2xx JSON response: { "success": boolean, "detail"?: string }
#   Any non-2xx response or thrown error is recorded as outcome FAILED.
ENDPOINT_CONTROL_API_URL=
ENDPOINT_CONTROL_API_KEY=
