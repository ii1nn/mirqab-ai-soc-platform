# Copy to .env in this same folder (infra/docker/), generate a dev TLS cert
# (only needed once — nginx.conf expects fullchain.pem/privkey.pem to exist):
#   ./nginx/certs/generate-self-signed-cert.sh
# then:
#   docker compose --env-file .env up --build

POSTGRES_USER=mirqab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mirqab

# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace-with-a-64-char-random-string-for-access-tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string-for-refresh
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# nginx (ports 80/443) is the main public entrypoint — dashboard and API are
# same-origin behind it. The second origin is apps/employee-desktop's Vite
# dev server (see its vite.config.ts) — that app talks to this backend
# directly, over plain HTTP on the port `docker compose port backend 3000`
# reports, bypassing nginx/TLS entirely (see docs/phases/phase-12.md).
CORS_ORIGIN=https://localhost,http://localhost:5174

ADMIN_EMAIL=admin@mirqab.local
ADMIN_PASSWORD=ChangeMe123!

# Phase 8: self-hosted/private AI — Mirqab's default/production path. Optional
# — falls back to rule-based triage when unset (see backend/README.md and
# MIRQAB-PHASE-8-SELF-HOSTED-AI-REPORT.md).
SELF_HOSTED_AI_URL=
SELF_HOSTED_AI_MODEL=
SELF_HOSTED_AI_TIMEOUT_MS=30000

# EXTERNAL/CLOUD AI (Anthropic Claude) — local development / quality
# comparison ONLY. Never set ALLOW_EXTERNAL_AI_DEV_ONLY=true in production.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ALLOW_EXTERNAL_AI_DEV_ONLY=false

# Shared secret for the Wazuh/Suricata/Sysmon forwarders in infra/monitoring/.
# Generate with: openssl rand -hex 32
MONITORING_INGEST_API_KEY=replace-with-a-long-random-shared-secret-for-monitoring-agents

# Optional — a real Wazuh Manager's REST API. Unset means Logtest enrichment
# is disabled and monitoring ingestion falls back to its own heuristic
# decoding (see backend/src/modules/monitoring/wazuh-logtest).
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
