# Mirqab evaluator demo — copy to infra/demo/.env.demo and fill in.
# Every value below is yours to choose; nothing here is a real credential.
# Generate random secrets with e.g.:  openssl rand -hex 32
#   (PowerShell: -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) }))

# --- Demo Admin (created on first start only; never duplicated) ---
DEMO_ADMIN_EMAIL=admin@mirqab.local
DEMO_ADMIN_PASSWORD=

# --- Optional RBAC demonstration accounts (created only if BOTH are set) ---
# The technician is scoped to the "Demo · APT29 Emulation Hosts" department.
DEMO_ANALYST_EMAIL=
DEMO_ANALYST_PASSWORD=
DEMO_TECHNICIAN_EMAIL=
DEMO_TECHNICIAN_PASSWORD=

# --- Internal secrets (random strings; never reuse production values) ---
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
MONITORING_INGEST_API_KEY=

# --- Optional ---
# Local port for the demo (http://localhost:<port>).
DEMO_HTTP_PORT=8080
